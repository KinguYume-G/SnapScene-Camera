<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    
    <!-- 顶部工具栏 - 确保所有按钮都显示 -->
    <LinearLayout
        android:id="@+id/topBarScroll"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">
        
        <!-- 左侧按钮组 -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="取消"
            android:textColor="#F44336"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnCrop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="裁剪"
            android:textColor="#666666"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnAutoEnhance"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="美颜"
            android:textColor="#666666"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            style="?attr/borderlessButtonStyle" />
            
        <Button
            android:id="@+id/btnAdjust"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="调整"
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_adjust_bg"
            style="?attr/borderlessButtonStyle" />
        
        <!-- 右侧按钮组 -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="分享"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="保存"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_save_bg"
            style="?attr/borderlessButtonStyle" />
    </LinearLayout>
    
    <!-- 图片预览区 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/topBarScroll"
        app:layout_constraintBottom_toTopOf="@id/backgroundSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <!-- 背景层 -->
        <View
            android:id="@+id/backgroundLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
        
        <!-- 前景层（抠图后的人像） -->
        <ImageView
            android:id="@+id/ivForeground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="抠图后的人像" />
        
        <!-- 调整框架 - 白色边框 -->
        <View
            android:id="@+id/adjustFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/adjust_frame_border"
            android:visibility="gone" />
        
        <!-- 加载动画 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        
        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="80dp"
            android:text="@string/processing"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
    
    <!-- 背景选择区 -->
    <LinearLayout
        android:id="@+id/backgroundSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_background"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />
        
        <!-- 颜色选择器 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBackgrounds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        
        <!-- 自定义背景卡片 -->
        <LinearLayout
            android:id="@+id/btnCustomBackground"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_gallery_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            
            <!-- 文件夹图标 -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_folder_orange"
                android:contentDescription="文件夹图标" />
            
            <!-- 文字区域 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                
                <!-- 主标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从相册选择"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />
                
                <!-- 副标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择您喜欢的背景图片"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            
            <!-- 右箭头 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="24sp"
                android:textColor="#CCCCCC" />
        </LinearLayout>
    </LinearLayout>
    
</androidx.constraintlayout.widget.ConstraintLayout>


